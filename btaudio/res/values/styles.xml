<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework Material, no AndroidX. This app has no widget that a
         framework theme cannot draw, and staying off the support libraries is
         what keeps the build a single command. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="Card">
        <item name="android:background">@color/card</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="Heading">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Mono">
        <item name="android:typeface">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text</item>
    </style>
</resources>
